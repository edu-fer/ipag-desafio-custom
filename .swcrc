{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": { 
      "syntax": "typescript",
      "decorators": true
    },
    "transform": {},
    "target": "es2024",
    "baseUrl": "./",
    "paths": {}
  },
  "sourceMaps": true,
  "isModule": true,
  "module":{
    "type": "es6",
    "resolveFully": true
  }
}